# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Testing / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Data (large/generated — keep raw & processed data out of git by default)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Exceptions: small, final backtest artifacts committed deliberately so
# evaluators can verify/re-render the deliverable without redoing the
# full expensive pipeline (see README.md's tiered evaluator flow).
!data/processed/backtest_results.pkl
!data/processed/prices.parquet
!data/processed/quarter_asset_detail.csv
!data/processed/subperiod_stats.csv

# `python -m src.run --mode smoke` output -- a throwaway wiring check
# against a tiny sample window (real content is not a meaningful backtest,
# see src/run.py's docstring), not a deliverable.
results/smoke/

# OS / editor
.DS_Store
.idea/
.vscode/

# Env secrets
.env

# Claude Code config -- local-only, not part of the deliverable
CLAUDE.md
.claudeignore
.claude/
